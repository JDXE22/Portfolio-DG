---
import Button from './Button.astro';
import VideoCard from './VideoCard.astro';
import type { Video } from '../data/portfolio';

interface Props {
  categories: string[];
  videos: Video[];
  initialVisible: number;
}

const { categories, videos, initialVisible } = Astro.props;

const emptyCategories = categories.filter(
  (cat) => cat !== 'All' && !videos.some((v) => v.category === cat)
);
---

<section
  id='cinematography'
  aria-label='Cinematography work'
  class='px-6 md:px-12 py-24 md:py-32'
  style='background: var(--color-surface);'>
  <div class='max-w-6xl mx-auto'>
    <div
      class='flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12'>
      <div>
        <p
          class='text-xs uppercase tracking-widest mb-3'
          style='color: var(--color-primary); letter-spacing: 0.15em;'>
          Work
        </p>
        <h2
          class='font-display font-bold text-on-surface leading-tight'
          style='font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.03em;'>
          Cinematography
        </h2>
      </div>

      <!-- Category filters -->
      <div
        role='group'
        aria-label='Filter by category'
        class='flex flex-wrap gap-2'
        id='filter-group'>
        {
          categories.map((cat, i) => (
            <button
              type='button'
              class={`filter-pill text-xs uppercase tracking-widest px-4 py-2 rounded-sm transition-all duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ${i === 0 ? 'active' : ''}`}
              data-filter={cat}
              aria-pressed={i === 0 ? 'true' : 'false'}>
              {cat}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Video grid — data-initial-visible read by script at runtime -->
    <div
      id='video-grid'
      class='grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6'
      role='list'
      aria-label='Video portfolio'
      data-initial-visible={initialVisible}>
      {
        videos.map((v, i) => (
          <div role='listitem'>
            <VideoCard
              id={v.id}
              title={v.title}
              category={v.category}
              youtubeId={v.youtubeId}
              poster={v.poster}
              meta={v.meta}
              hidden={i >= initialVisible}
            />
          </div>
        ))
      }
      {
        emptyCategories.map((cat, i) => (
          <div role='listitem'>
            <article
              class='video-card scroll-reveal relative rounded-lg overflow-hidden flex flex-col justify-between p-5 md:p-6 aspect-video border border-[color-mix(in_srgb,var(--color-outline-variant)_20%,transparent)] cursor-default group'
              data-category={cat}
              data-hidden={videos.length + i >= initialVisible ? 'true' : 'false'}
              style='background: var(--color-surface-container-lowest);'
              aria-label={`${cat} — Content in progress`}>
              <!-- Background subtle glow -->
              <div
                class='absolute inset-0 pointer-events-none opacity-40 group-hover:opacity-70 transition-opacity duration-500'
                style='background: radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--color-primary) 12%, transparent) 0%, transparent 60%), radial-gradient(circle at 80% 80%, color-mix(in srgb, var(--color-surface-container-high) 40%, transparent) 0%, transparent 60%);'
                aria-hidden='true'>
              </div>

              <!-- Top bar -->
              <div class='relative z-10 flex items-center justify-between gap-2'>
                <span
                  class='text-xs uppercase tracking-widest font-semibold px-2.5 py-1 rounded-sm border inline-block'
                  style='color: var(--color-primary); border-color: color-mix(in srgb, var(--color-primary) 30%, transparent); background: color-mix(in srgb, var(--color-primary) 8%, transparent); letter-spacing: 0.15em;'>
                  {cat}
                </span>
                <div
                  class='w-8 h-8 md:w-9 md:h-9 rounded-full flex items-center justify-center border border-[color-mix(in_srgb,var(--color-primary)_20%,transparent)]'
                  style='background: color-mix(in srgb, var(--color-surface-container) 80%, transparent);'
                  aria-hidden='true'>
                  <svg
                    width='16'
                    height='16'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.5'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    style='color: var(--color-primary);'>
                    <path d='M23 7l-7 5 7 5V7z'></path>
                    <rect x='1' y='5' width='15' height='14' rx='2' ry='2'></rect>
                  </svg>
                </div>
              </div>

              <!-- Middle section -->
              <div class='relative z-10 my-auto py-2'>
                <h3 class='font-display text-base md:text-lg font-semibold text-on-surface leading-snug'>
                  Content in Progress
                </h3>
                <p
                  class='text-xs md:text-sm leading-relaxed mt-1 line-clamp-2'
                  style='color: var(--color-on-surface-variant);'>
                  Cinematography work for {cat} is currently being worked on and will be available soon.
                </p>
              </div>

              <!-- Bottom status footer -->
              <div
                class='relative z-10 flex items-center gap-2 pt-3 border-t border-[color-mix(in_srgb,var(--color-outline-variant)_15%,transparent)]'>
                <span class='relative flex h-2 w-2'>
                  <span
                    class='animate-ping absolute inline-flex h-full w-full rounded-full opacity-75'
                    style='background-color: var(--color-primary);'></span>
                  <span
                    class='relative inline-flex rounded-full h-2 w-2'
                    style='background-color: var(--color-primary);'></span>
                </span>
                <span
                  class='text-[10px] md:text-xs uppercase tracking-widest font-medium'
                  style='color: var(--color-on-surface-variant); letter-spacing: 0.15em;'>
                  In Development • Coming Soon
                </span>
              </div>
            </article>
          </div>
        ))
      }
    </div>

    <!-- View All -->
    {
      videos.length + emptyCategories.length > initialVisible && (
        <div class='mt-10 text-center scroll-reveal'>
          <Button
            variant='secondary'
            id='view-all-btn'
            label='Show all cinematography work'>
            View All Work
          </Button>
        </div>
      )
    }
  </div>
</section>

<script>
  const filterGroup = document.getElementById('filter-group');
  const videoGrid = document.getElementById('video-grid');
  const viewAllBtn = document.getElementById('view-all-btn');

  const INITIAL_VISIBLE_COUNT = parseInt(
    (videoGrid as HTMLElement | null)?.dataset.initialVisible ?? '4',
    10,
  );


  let isGridExpanded = false;

  function cardMatchesFilter(card: HTMLElement, filter: string): boolean {
    return filter === 'All' || card.dataset.category === filter;
  }

  function getActiveFilter(): string {
    const activePill = filterGroup?.querySelector('.filter-pill.active');
    return (
      (activePill instanceof HTMLElement ? activePill.dataset.filter : null) ??
      'All'
    );
  }

  function collapseGrid(filter: string) {
    if (!videoGrid) return;
    let visibleCount = 0;
    videoGrid.querySelectorAll('.video-card').forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      if (cardMatchesFilter(card, filter)) {
        visibleCount++;
        card.dataset.hidden =
          visibleCount > INITIAL_VISIBLE_COUNT ? 'true' : 'false';
      }
    });
  }

  function syncViewAllButton(filter: string) {
    if (!viewAllBtn || !videoGrid) return;
    let matchCount = 0;
    videoGrid.querySelectorAll('.video-card').forEach((card) => {
      if (card instanceof HTMLElement && cardMatchesFilter(card, filter))
        matchCount++;
    });
    viewAllBtn.hidden = matchCount <= INITIAL_VISIBLE_COUNT;
    viewAllBtn.textContent = 'View All Work';
    viewAllBtn.setAttribute('aria-label', 'Show all cinematography work');
  }

  if (filterGroup && videoGrid) {
    const filterGroupEl = filterGroup;
    const videoGridEl = videoGrid;

    filterGroupEl.addEventListener('click', (e) => {
      if (!(e.target instanceof HTMLElement)) return;
      const clickedPill = e.target.closest('.filter-pill');
      if (!(clickedPill instanceof HTMLElement)) return;

      const selectedFilter = clickedPill.dataset.filter ?? 'All';

      filterGroupEl.querySelectorAll('.filter-pill').forEach((pill) => {
        const isActive = pill === clickedPill;
        pill.classList.toggle('active', isActive);
        pill.setAttribute('aria-pressed', String(isActive));

      });

      videoGridEl.querySelectorAll('.video-card').forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        card.dataset.hidden = cardMatchesFilter(card, selectedFilter)
          ? 'false'
          : 'true';
      });

      isGridExpanded = false;
      collapseGrid(selectedFilter);
      syncViewAllButton(selectedFilter);
    });
  }

  if (viewAllBtn && videoGrid) {
    const viewAllButtonEl = viewAllBtn;
    const videoGridEl = videoGrid;

    viewAllButtonEl.addEventListener('click', () => {
      const activeFilter = getActiveFilter();
      if (!isGridExpanded) {
        videoGridEl.querySelectorAll('.video-card').forEach((card) => {
          if (
            card instanceof HTMLElement &&
            cardMatchesFilter(card, activeFilter)
          ) {
            card.dataset.hidden = 'false';
          }
        });
        viewAllButtonEl.textContent = 'Show Less';
        viewAllButtonEl.setAttribute('aria-label', 'Show fewer videos');
        isGridExpanded = true;
      } else {
        collapseGrid(activeFilter);
        viewAllButtonEl.textContent = 'View All Work';
        viewAllButtonEl.setAttribute(
          'aria-label',
          'Show all cinematography work',
        );
        isGridExpanded = false;
      }
    });
  }
</script>
